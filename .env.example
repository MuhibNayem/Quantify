# Quantify - Local Development Environment
# Copy this file to .env and adjust values as needed.

# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=inventory_db
POSTGRES_PORT=5432
POSTGRES_REPLICA_PORT=5433

# Redis Cluster
REDIS_PASS=redispass

# RabbitMQ
RABBITMQ_USER=user
RABBITMQ_PASSWORD=password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO
MINIO_ACCESS_KEY_ID=minioadmin4321
MINIO_SECRET_ACCESS_KEY=minioadmin4321
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=reports
MINIO_USE_TLS=false

# Backend
BACKEND_PORT=8080
SERVER_PORT=8080
DB_HOST=db
DB_PORT=5432
JWT_SECRET=my_secret_key
REFRESH_TOKEN_SECRET=my_refresh_secret_key
REFRESH_TOKEN_TTL=720h
RedisClusterAddrs=redis1:6379,redis2:6379,redis3:6379
RABBITMQ_URL=amqp://user:password@rabbitmq:5672/

# SMTP (Mailhog for local dev)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTPSENDER=noreply@quantify.local

# AI Service
AI_SERVICE_PORT=8001
AI_SERVICE_URL=http://ai-service:8000
AI_AGENT_PASSWORD=

# SSLCommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_API_HOST=https://sandbox.sslcommerz.com
SSLCOMMERZ_SUCCESS_URL=http://localhost:8080/payment/success
SSLCOMMERZ_FAIL_URL=http://localhost:8080/payment/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:8080/payment/cancel
SSLCOMMERZ_IPN_URL=http://localhost:8080/payment/ipn

# bKash
BKASH_API_KEY=
BKASH_API_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://sandbox.bkash.com/v1.2.0-beta

# Reporting cache TTLs
SALES_TRENDS_CACHE_TTL=1h
INVENTORY_TURNOVER_CACHE_TTL=6h
PROFIT_MARGIN_CACHE_TTL=2h

# Rate limiting (Redis-backed, per client IP)
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW=1m

# Monitoring
PROMETHEUS_PORT=9092
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=password
LOKI_PORT=3100

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@quantify.dev
PGADMIN_PASSWORD=password

# Mailhog
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
