# Z.AI (OpenAI-compatible) credentials
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4/

# Must match the backend's AI_AGENT_PASSWORD so the service can log in
# as the seeded ai-agent user.
AI_AGENT_PASSWORD=
AI_USER_USERNAME=ai-agent
AI_USER_EMAIL=ai-agent@quantify.com

# Backend base URL (Compose: http://backend:8080)
BACKEND_URL=http://localhost:8080
