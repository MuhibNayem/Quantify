# Copy this file to .env for local development.
# Never commit .env or real credentials and secrets.

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=inventory
DB_HOST=db
DB_PORT=5432
SERVER_PORT=8080

# Allowed browser origins for CORS and WebSocket (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTPSENDER=
RedisClusterAddrs=redis1:6379,redis2:6379,redis3:6379
REDIS_PASS=redispass
RABBITMQ_URL=amqp://user:password@rabbitmq:5672/
JWT_SECRET=my_secret_key
REFRESH_TOKEN_SECRET=my_refresh_secret_key

# SSLCommerz — used for both gateway auth and IPN signature verification
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_API_HOST=https://sandbox.sslcommerz.com
SSLCOMMERZ_SUCCESS_URL=http://localhost:8080/payment/success
SSLCOMMERZ_FAIL_URL=http://localhost:8080/payment/fail
SSLCOMMERZ_CANCEL_URL=http://localhost:8080/payment/cancel
SSLCOMMERZ_IPN_URL=http://localhost:8080/payment/ipn

# bKash
BKASH_API_KEY=
BKASH_API_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://sandbox.bkash.com/v1.2.0-beta

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=minioadmin
MINIO_BUCKET_NAME=reports
MINIO_USE_TLS=false

# Reporting cache TTLs (Go duration format)
SALES_TRENDS_CACHE_TTL=1h
INVENTORY_TURNOVER_CACHE_TTL=6h
PROFIT_MARGIN_CACHE_TTL=2h

# Refresh token TTL (Go duration format). Default 720h = 30 days.
REFRESH_TOKEN_TTL=720h

# AI agent password, shared with ai-service. If empty, the backend generates
# one on first boot and prints it once; set that value here and in the
# ai-service environment so it can authenticate.
AI_AGENT_PASSWORD=

# Rate limiting (Redis-backed, per client IP)
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW=1m
# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For is trusted.
# Leave empty to rate-limit on the socket address.
TRUSTED_PROXIES=
