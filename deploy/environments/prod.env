APP_ENV=production
SERVER_PORT=8080
LOG_LEVEL=warn

DB_HOST=quantify-infrastructure-postgresql
DB_PORT=5432
DB_NAME=inventory_db
DB_USER=quantify

REDIS_CLUSTER_ADDRS=quantify-infrastructure-redis-cluster-0.quantify-infrastructure-redis-cluster-headless:6379,quantify-infrastructure-redis-cluster-1.quantify-infrastructure-redis-cluster-headless:6379,quantify-infrastructure-redis-cluster-2.quantify-infrastructure-redis-cluster-headless:6379

MINIO_ENDPOINT=quantify-infrastructure-minio:9000
MINIO_BUCKET_NAME=reports
MINIO_USE_TLS=true

AI_SERVICE_URL=http://quantify-ai-service:8000
CONSUMER_CONCURRENCY=4

CORS_ALLOWED_ORIGINS=https://app.quantify.com
WS_ALLOWED_ORIGINS=https://app.quantify.com

SSLCOMMERZ_API_HOST=https://securepay.sslcommerz.com
SSLCOMMERZ_SUCCESS_URL=https://api.quantify.com/payment/success
SSLCOMMERZ_FAIL_URL=https://api.quantify.com/payment/fail
SSLCOMMERZ_CANCEL_URL=https://api.quantify.com/payment/cancel
SSLCOMMERZ_IPN_URL=https://api.quantify.com/payment/ipn
BKASH_BASE_URL=https://checkout.pay.bkash.com/v1.2.0-beta

SMTP_HOST=
SMTP_PORT=587
SMTPSENDER=noreply@quantify.com

OTLP_ENDPOINT=
