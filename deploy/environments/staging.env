MINIO_USE_TLS=false

AI_SERVICE_URL=http://quantify-ai-service:8000
CONSUMER_CONCURRENCY=2

CORS_ALLOWED_ORIGINS=https://app.staging.quantify.dev
WS_ALLOWED_ORIGINS=https://app.staging.quantify.dev

SSLCOMMERZ_API_HOST=https://sandbox.sslcommerz.com
