APP_ENV=staging
SERVER_PORT=8080
LOG_LEVEL=info

DB_HOST=quantify-infrastructure-postgresql
DB_PORT=5432
DB_NAME=inventory_db
DB_USER=quantify

REDIS_CLUSTER_ADDRS=quantify-infrastructure-redis-cluster-0.quantify-infrastructure-redis-cluster-headless:6379,quantify-infrastructure-redis-cluster-1.quantify-infrastructure-redis-cluster-headless:6379,quantify-infrastructure-redis-cluster-2.quantify-infrastructure-redis-cluster-headless:6379

MINIO_ENDPOINT=quantify-infrastructure-minio:9000
