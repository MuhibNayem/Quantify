terraform {
  required_version = ">= 1.5.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.70"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 2.32"
    }
    helm = {
      source  = "hashicorp/helm"
      version = "~> 2.15"
    }
  }

  # Remote state: configure via `terraform init -backend-config=backend.hcl`.
  # See terraform.tfvars.example for a ready-to-use backend.hcl template that
  # enables S3 storage, encryption at rest, and DynamoDB state locking.
  backend "s3" {}
}
